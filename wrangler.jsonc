{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "david-weng-portfolio",
  "main": "workers/site.mjs",
  "compatibility_date": "2026-06-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
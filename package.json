    "jsdom": "29.1.1",
    "oxlint": "^1.72.0",
    "react-server-dom-webpack": "^19.2.7",
    "subset-font": "^2.5.0",
    "typescript": "6.0.3",
    "vinext": "^0.2.0",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "^4.105.0"

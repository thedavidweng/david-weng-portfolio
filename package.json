{
  "name": "david-weng-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "subset:fonts": "node scripts/subset-cjk-fonts.mjs",
    "generate:images": "node scripts/generate-responsive-images.mjs",
    "apply:zone": "node scripts/apply-cf-zone-free-tier.mjs",
    "prebuild": "pnpm subset:fonts",
    "build": "astro build && node scripts/write-headers.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:zone": "node scripts/verify-zone-redirects.mjs --curl",
    "preview": "pnpm build && cf dev",
    "deploy": "pnpm build && cf deploy",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "changelog": "git-cliff -o CHANGELOG.md",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.3",
    "image-size": "2.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-photo-album": "3.6.1",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "cf": "1.0.0-beta.5",
    "jsdom": "30.0.1",
    "knip": "^6.34.0",
    "oxlint": "1.83.0",
    "sharp": "^0.35.4",
    "subset-font": "2.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.141.0"
  },
  "packageManager": "pnpm@12.3.2"
}

{
  "name": "david-weng-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "subset:fonts": "node scripts/subset-cjk-fonts.mjs",
    "prebuild": "pnpm subset:fonts",
    "build": "astro build && node scripts/write-headers.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "astro preview",
    "deploy": "pnpm build && pnpm verify:dist && wrangler deploy",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.3.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "astro": "^5.7.10",
    "image-size": "^2.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-photo-album": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "29.1.1",
    "oxlint": "^1.72.0",
    "subset-font": "^2.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wrangler": "^4.105.0"
  },
  "packageManager": "pnpm@11.9.0"
}
{
  "name": "david-weng-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "subset:fonts": "node scripts/subset-cjk-fonts.mjs",
    "prebuild": "pnpm subset:fonts && pnpm exec vitest run tests/generate-carousel-projects.test.ts",
    "build": "astro build && node scripts/write-headers.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "test": "vitest run tests/generate-carousel-projects.test.ts && vitest run"
  },
  "dependencies": {
    "@astrojs/react": "6.0.0",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.0.3",
    "image-size": "2.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-photo-album": "3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "29.1.1",
    "oxlint": "1.72.0",
    "subset-font": "2.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  },
  "packageManager": "pnpm@11.9.0"
}
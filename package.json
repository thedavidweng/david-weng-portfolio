{
  "name": "david-weng-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "subset:fonts": "node scripts/subset-cjk-fonts.mjs",
    "generate:images": "node scripts/generate-responsive-images.mjs",
    "apply:zone": "node scripts/apply-cf-zone-free-tier.mjs",
    "prebuild": "bun run subset:fonts",
    "build": "astro build && node scripts/write-headers.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:zone": "node scripts/verify-zone-redirects.mjs --curl",
    "preview": "bun run build && cf dev",
    "deploy": "bun run build && cf deploy",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "changelog": "git-cliff -o CHANGELOG.md",
    "test": "vp test run"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "image-size": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-photo-album": "3.6.2",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "cf": "1.0.0-beta.23",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "sharp": "^0.35.5",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.153.0"
  },
  "workspaces": {
    "packages": [
      "."
    ],
    "catalog": {
      "vitest": "5.0.5",
      "vite-plus": "1.4.0",
      "@vitest/coverage-v8": "5.0.5"
    }
  },
  "overrides": {
    "zod": ">=4.6.7",
    "undici@7": ">=7.30.1 <8",
    "vite@*": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest@*": "catalog:"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}

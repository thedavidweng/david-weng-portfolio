{
  "name": "david-weng-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "subset:fonts": "node scripts/subset-cjk-fonts.mjs",
    "generate:images": "node scripts/generate-responsive-images.mjs",
    "apply:zone": "node scripts/apply-cf-zone-free-tier.mjs",
    "prebuild": "bun run subset:fonts",
    "build": "astro build && node scripts/write-headers.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:zone": "node scripts/verify-zone-redirects.mjs --curl",
    "preview": "bun run build && astro preview",
    "deploy": "bun run build && cf deploy --prebuilt",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "changelog": "git-cliff -o CHANGELOG.md",
    "test": "vp test run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.6",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13",
    "image-size": "2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-photo-album": "3.6.2",
    "yet-another-react-lightbox": "3.33.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "cf": "1.0.0-rc.2",
    "jsdom": "31.0.1",
    "knip": "6.47.0",
    "sharp": "^0.35.5",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "workspaces": {
    "packages": ["."],
    "catalog": {
      "vitest": "5.1.0",
      "vite-plus": "1.4.0",
      "@vitest/coverage-v8": "5.1.0"
    }
  },
  "overrides": {
    "zod": ">=4.6.7",
    "undici@7": ">=7.30.1 <8",
    "vite@*": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest@*": "catalog:"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}

---
import ProjectLayout from "@/src/layouts/ProjectLayout.astro";
import { getProjectPageStaticPaths } from "@/lib/astro-static-paths";

export function getStaticPaths() {
  return getProjectPageStaticPaths("zh");
}

const { project, pathname, metadata, jsonLd } = Astro.props;
---

<ProjectLayout locale="zh" pathname={pathname} project={project} metadata={metadata} jsonLd={jsonLd} />
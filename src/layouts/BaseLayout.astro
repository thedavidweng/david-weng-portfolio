---
import JsonLd from "@/src/components/JsonLd.astro";
import { buildPersonSchema, buildWebSiteSchema } from "@/lib/jsonld";
import { SITE_URL } from "@/lib/site-config";
import type { Locale } from "@/types/content";
import manropeFont from "../../assets/fonts/manrope-latin-wght-normal.woff2?url";
import notoSansSc400Font from "../../assets/fonts/noto-sans-sc-chinese-simplified-400-normal.woff2?url";
import notoSansSc700Font from "../../assets/fonts/noto-sans-sc-chinese-simplified-700-normal.woff2?url";
import outfitFont from "../../assets/fonts/outfit-latin-wght-normal.woff2?url";
import "@/src/styles/fonts.css";
import "@/src/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  locale?: Locale;
  alternateEn?: string;
  alternateZh?: string;
  ogImage?: string;
}

const {
  title = "David Weng | Visual Storytelling, Design, and Creative Systems",
  description = "Portfolio of David Weng — video editing, photography, graphic design, and content operations.",
  canonical = "/",
  locale = "en",
  alternateEn = "/",
  alternateZh = "/zh/",
  ogImage = "/brand/og-image.png"
} = Astro.props;

const htmlLang = locale;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070607" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${SITE_URL}${canonical}`} />
    <link rel="alternate" hreflang="en" href={`${SITE_URL}${alternateEn}`} />
    <link rel="alternate" hreflang="zh" href={`${SITE_URL}${alternateZh}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "zh" ? "zh" : "en"} />
    <meta property="og:site_name" content="David Weng" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${SITE_URL}${canonical}`} />
    <meta property="og:image" content={`${SITE_URL}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}${ogImage}`} />
    <link rel="icon" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/favicon.png" />
    {locale === "zh" ? (
      <>
        <link rel="preload" href={notoSansSc400Font} as="font" type="font/woff2" crossorigin fetchpriority="high" />
        <link rel="preload" href={notoSansSc700Font} as="font" type="font/woff2" crossorigin fetchpriority="high" />
      </>
    ) : (
      <>
        <link rel="preload" href={outfitFont} as="font" type="font/woff2" crossorigin fetchpriority="high" />
        <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin fetchpriority="high" />
      </>
    )}
    <slot name="head" />
  </head>
  <body class={locale === "zh" ? "site-body--zh" : undefined} style={locale === "zh" ? "--font-home-zh-active: var(--font-home-zh)" : undefined}>
    <slot />
    <JsonLd data={buildPersonSchema(locale)} />
    <JsonLd data={buildWebSiteSchema(locale)} />
  </body>
</html>

<style is:global>
  body {
    font-family: var(--font-body);
  }

  body.site-body--zh .site-shell--zh {
    font-family: var(--font-home-zh);
  }
</style>
---
import Container from "@/src/components/Container.astro";
import Footer from "@/src/components/Footer.astro";
import JsonLd from "@/src/components/JsonLd.astro";
import PortfolioImage from "@/src/components/PortfolioImage.astro";
import ProjectArchiveLedger from "@/src/components/ProjectArchiveLedger.astro";
import ProjectExternalLinkButton from "@/src/components/ProjectExternalLinkButton.astro";
import ProjectFilmHero from "@/src/components/ProjectFilmHero.astro";
import ProjectFilmRails from "@/src/components/ProjectFilmRails.astro";
import ProjectMaterialsSection from "@/src/components/ProjectMaterialsSection.astro";
import ProjectSummary from "@/src/components/ProjectSummary.astro";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { Header } from "@/src/islands/Header";
import { projectDetailContent } from "@/content/projects";
import { getLocalizedText } from "@/lib/i18n";
import { getLocaleHomePath } from "@/lib/i18n";
import { getHostname } from "@/lib/url";
import { getImageWidth } from "@/lib/image-dimensions";
import type { Locale, ProjectItem } from "@/types/content";

interface Props {
  locale: Locale;
  pathname: string;
  project: ProjectItem;
  metadata: {
    title: string;
    description: string;
    canonical: string;
    languages: { en: string; zh: string };
    openGraph: { images: Array<{ url: string; alt: string }> };
  };
  jsonLd: object;
}

const { locale, pathname, project, metadata, jsonLd } = Astro.props;
const homePath = getLocaleHomePath(locale);
const useImageWall = Boolean(project.archiveGroup);
const isTitleOnly = project.detailLayout === "title-only";
const isExternalHandoff = project.detailLayout === "external-handoff";
const isFilmProject = project.category.en === "Film";
const isVideoProject = project.category.en === "Video";
const isFilmOrVideoProject = isFilmProject || isVideoProject;
const isDedicatedFilmProject = isFilmProject && Boolean(project.film) && !useImageWall;
const isArchiveVideoProject = isVideoProject && useImageWall;
const primaryExternalLink = project.externalLinks[0];
const ogImage = metadata.openGraph.images[0]?.url ?? project.coverImage;
const coverWidth = project.coverImage ? getImageWidth(project.coverImage) : undefined;
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  canonical={metadata.canonical}
  locale={locale}
  alternateEn={metadata.languages.en}
  alternateZh={metadata.languages.zh}
  ogImage={ogImage}
>
  <JsonLd data={jsonLd} slot="head" />
  <div class={`site-shell site-shell--${locale}`}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header client:load locale={locale} pathname={pathname} />
    <main
      id="main-content"
      class={`project-page${useImageWall ? " project-page--archive" : ""}${isTitleOnly ? " project-page--title-only" : ""}${isExternalHandoff ? " project-page--external-handoff" : ""}${isDedicatedFilmProject ? " project-page--film" : ""}`}
    >
      <section class="project-hero">
        <Container>
          <div class="project-hero__frame">
            <div class="project-hero__header">
              <a class="project-hero__back signal-control signal-control--nav" href={`${homePath}#projects`}>
                {getLocalizedText(projectDetailContent.backLabel, locale)}
              </a>
              <div class="project-hero__micro">
                <span>[{project.code}]</span>
                <span>[{getLocalizedText(project.category, locale)}]</span>
                <span>[{project.year}]</span>
              </div>
            </div>
            <div
              class={`project-hero__grid${isTitleOnly ? " project-hero__grid--title-only" : ""}${isExternalHandoff ? " project-hero__grid--external-handoff" : ""}${isDedicatedFilmProject ? " project-hero__grid--film" : ""}`}
            >
              {isDedicatedFilmProject ? <ProjectFilmHero locale={locale} project={project} /> : null}
              {!isDedicatedFilmProject ? (
                <div
                  class={`project-hero__content${useImageWall ? " project-hero__content--archive" : ""}${isTitleOnly ? " project-hero__content--title-only" : ""}${isExternalHandoff ? " project-hero__content--external-handoff" : ""}`}
                >
                  <div class={`project-hero__archive-intro${useImageWall ? " project-hero__archive-intro--stacked" : ""}`}>
                    {isExternalHandoff ? (
                      <p class="project-hero__article-eyebrow">{getLocalizedText(project.projectType, locale)}</p>
                    ) : null}
                    <h1 class="project-hero__title">{getLocalizedText(project.title, locale)}</h1>
                    {!isTitleOnly && !isExternalHandoff ? (
                      <>
                        <p class="project-hero__summary">
                          <ProjectSummary locale={locale} project={project} />
                        </p>
                        <div class="project-detail__links">
                          {project.externalLinks.map((link) => (
                            <ProjectExternalLinkButton href={link.href} label={getLocalizedText(link.label, locale)} />
                          ))}
                        </div>
                      </>
                    ) : null}
                    {isExternalHandoff ? (
                      <>
                        <p class="project-hero__publication">
                          {getLocalizedText(projectDetailContent.publicationLabel, locale)} {getLocalizedText(project.duration, locale)}
                        </p>
                        <p class="project-hero__summary">
                          <ProjectSummary locale={locale} project={project} />
                        </p>
                      </>
                    ) : null}
                  </div>
                  {useImageWall ? <ProjectArchiveLedger locale={locale} project={project} /> : null}
                </div>
              ) : null}
              {isExternalHandoff && primaryExternalLink ? (
                <aside class="project-handoff signal-panel">
                  <p class="poster-section__eyebrow">{getLocalizedText(projectDetailContent.externalEyebrow, locale)}</p>
                  <h2 class="project-handoff__title">{getLocalizedText(project.duration, locale)}</h2>
                  <p class="project-handoff__copy">{getLocalizedText(projectDetailContent.externalHint, locale)}</p>
                  <div class="project-handoff__meta">
                    <span>{getLocalizedText(projectDetailContent.externalDestinationLabel, locale)}</span>
                    <span>{getHostname(primaryExternalLink.href)}</span>
                  </div>
                  <a class="button button--signal" href={primaryExternalLink.href} rel="noreferrer" target="_blank">
                    {getLocalizedText(primaryExternalLink.label, locale)}
                    <span class="visually-hidden">(opens in new tab)</span>
                  </a>
                </aside>
              ) : null}
              {!isTitleOnly && !isExternalHandoff && !isDedicatedFilmProject ? (
                <div
                  class="project-hero__cover"
                  style={`background:linear-gradient(145deg,${project.coverPalette[0]},${project.coverPalette[1]} 55%,${project.coverPalette[2]})`}
                >
                  <PortfolioImage
                    alt={getLocalizedText(project.coverAlt, locale)}
                    class="project-hero__cover-image"
                    fill
                    priority
                    sizes="(max-width: 1120px) 100vw, 40vw"
                    src={project.coverImage}
                    width={coverWidth}
                  />
                  {!useImageWall ? (
                    <>
                      <div class="project-hero__word" aria-hidden="true">{project.posterWord}</div>
                      <div class="project-hero__cover-meta">
                        <span>{getLocalizedText(project.coverLabel, locale)}</span>
                        <span>{getLocalizedText(project.duration, locale)}</span>
                      </div>
                    </>
                  ) : (
                    <div class="project-hero__cover-meta project-hero__cover-meta--archive">
                      <span>{getLocalizedText(project.coverLabel, locale)}</span>
                    </div>
                  )}
                </div>
              ) : null}
            </div>
          </div>
        </Container>
      </section>

      {!project.archiveGroup && !isTitleOnly && !isExternalHandoff && !isFilmOrVideoProject ? (
        <section class="project-detail">
          <Container>
            <div class="project-detail__grid">
              <div class="signal-panel">
                <p class="poster-section__eyebrow">{getLocalizedText(projectDetailContent.highlightsEyebrow, locale)}</p>
                <h2 class="project-detail__title">{getLocalizedText(projectDetailContent.highlightsTitle, locale)}</h2>
                <ul class="project-detail__list">
                  {project.highlights[locale].map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>
            </div>
          </Container>
        </section>
      ) : null}

      {isDedicatedFilmProject && project.film ? <ProjectFilmRails locale={locale} project={project} /> : null}

      {!isTitleOnly && !isExternalHandoff && (!isFilmOrVideoProject || isArchiveVideoProject) ? (
        <ProjectMaterialsSection locale={locale} project={project} useImageWall={useImageWall} />
      ) : null}
    </main>
    <Footer locale={locale} />
  </div>
</BaseLayout>
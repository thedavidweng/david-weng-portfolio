---
import LocalizedInlineText from "@/src/components/LocalizedInlineText.astro";
import { getLocalizedText } from "@/lib/i18n";
import type { Locale, ProjectItem } from "@/types/content";

interface Props {
  locale: Locale;
  project: ProjectItem;
}

const { locale, project } = Astro.props;
---

{project.detailSummary ? (
  <LocalizedInlineText locale={locale} linkClassName="project-hero__summary-link" value={project.detailSummary} />
) : (
  getLocalizedText(project.summary, locale)
)}
---
import { getLocalizedText } from "@/lib/i18n";
import type { Locale, ProjectItem } from "@/types/content";

interface Props {
  locale: Locale;
  project: ProjectItem;
}

const { locale, project } = Astro.props;
const roles = project.roles[locale];
---

<aside
  class="project-hero__archive-ledger"
  aria-label={`${getLocalizedText(project.category, locale)} ${project.year}`}
>
  <p class="poster-section__eyebrow">
    {getLocalizedText(project.category, locale)} · {project.year}
  </p>
  {roles.length > 0 ? (
    <ul class="project-hero__archive-roles">
      {roles.map((role) => (
        <li class="project-hero__archive-role">{role}</li>
      ))}
    </ul>
  ) : null}
  <span class="project-hero__archive-watermark" aria-hidden="true" inert>{project.posterWord}</span>
</aside>

---
import { YOUTUBE_ICON_PATH, EXTERNAL_LINK_ICON_PATH } from "@/src/icons";

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
const iconPath = href.includes("youtu") ? YOUTUBE_ICON_PATH : EXTERNAL_LINK_ICON_PATH;
---

<a class="button button--signal project-link-button" href={href} rel="noreferrer" target="_blank">
  <span>{label}</span>
  <svg aria-hidden="true" class="project-link-button__icon" viewBox="0 0 24 24">
    <path d={iconPath} fill="currentColor" />
  </svg>
  <span class="visually-hidden">(opens in new tab)</span>
</a>

---
import { buildSrcset } from "@/lib/responsive-srcset";

interface Props {
  alt: string;
  class?: string;
  fill?: boolean;
  height?: number;
  loading?: "lazy" | "eager";
  priority?: boolean;
  sizes?: string;
  src: string;
  width?: number;
}

const { alt, class: className, fill, height, loading, priority, sizes, src, width } = Astro.props;
const resolvedLoading = priority ? "eager" : (loading ?? "lazy");
const srcset = buildSrcset(src, width);
---

<img
  alt={alt}
  class={className}
  decoding="async"
  height={fill ? undefined : height}
  loading={resolvedLoading}
  sizes={sizes}
  src={src}
  srcset={srcset}
  style={fill ? "position:absolute;inset:0;width:100%;height:100%;object-fit:cover" : undefined}
  width={fill ? undefined : width}
/>

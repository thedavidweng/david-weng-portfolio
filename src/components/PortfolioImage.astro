---
interface Props {
  alt: string;
  class?: string;
  fill?: boolean;
  height?: number;
  loading?: "lazy" | "eager";
  priority?: boolean;
  sizes?: string;
  src: string;
  width?: number;
}

const { alt, class: className, fill, height, loading, priority, sizes, src, width } = Astro.props;
const resolvedLoading = priority ? "eager" : (loading ?? "lazy");
---

{fill ? (
  <img
    alt={alt}
    class={className}
    decoding="async"
    loading={resolvedLoading}
    sizes={sizes}
    src={src}
    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
  />
) : (
  <img
    alt={alt}
    class={className}
    decoding="async"
    height={height}
    loading={resolvedLoading}
    sizes={sizes}
    src={src}
    width={width}
  />
)}
---
import Container from "@/src/components/Container.astro";
import { heroContent } from "@/content/site";
import { githubUser, softwarePageContent } from "@/content/software";
import { getLocalizedText, getSoftwarePath } from "@/lib/i18n";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (value: { en: string; zh: string }) => getLocalizedText(value, locale);
const headline = t(heroContent.headline);
---

<section
  class={`home-hero${locale === "zh" ? " home-hero--zh" : ""}`}
  id="top"
  data-live
  data-github-user={githubUser}
  data-pushed-template={t(softwarePageContent.pushedLabel)}
>
  <Container>
    <a class="status-pill" href={getSoftwarePath(locale)}>
      <span class="status-pill__dot" aria-hidden="true"></span>
      <span data-activity>{t(softwarePageContent.eyebrow)}</span>
    </a>
    <h1 class="poster home-hero__title">{headline}</h1>
    <div class="home-hero__copy">
      <p class="home-hero__kicker">{t(heroContent.kicker)}</p>
      <p class="home-hero__lede">{t(heroContent.support)}</p>
    </div>
  </Container>
</section>

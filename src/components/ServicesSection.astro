---
import Container from "@/src/components/Container.astro";
import SectionHead from "@/src/components/SectionHead.astro";
import ServiceCard from "@/src/components/ServiceCard.astro";
import { servicesContent } from "@/content/site";
import { getLocalizedText } from "@/lib/i18n";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <Container>
    <SectionHead index="02" title={getLocalizedText(servicesContent.title, locale)} id="services-title">
      {getLocalizedText(servicesContent.description, locale)}
    </SectionHead>
    <div class="frame-grid" data-spotlight>
      {servicesContent.items.map((service, index) => (
        <ServiceCard index={index} locale={locale} service={service} />
      ))}
    </div>
  </Container>
</section>

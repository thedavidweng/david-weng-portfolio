---
import Container from "@/src/components/Container.astro";
import PortfolioImage from "@/src/components/PortfolioImage.astro";
import ArchiveMediaWall from "@/src/islands/ArchiveMediaWall";
import { projectDetailContent, projectLabel } from "@/content/projects";
import { getImageWidth } from "@/lib/image-dimensions";
import type { Locale, ProjectItem, ProjectMediaItem } from "@/types/content";

interface Props {
  locale: Locale;
  project: ProjectItem;
  useImageWall: boolean;
}

const { locale, project, useImageWall } = Astro.props;

function isArchiveVideoItem(item: ProjectMediaItem) {
  return item.type === "image" && item.archiveKind === "video";
}

const archiveVideoItems = useImageWall ? project.media.filter(isArchiveVideoItem) : [];
const archiveStaticItems = useImageWall ? project.media.filter((item) => !isArchiveVideoItem(item)) : [];
const useSplitArchiveLayout = useImageWall && archiveVideoItems.length > 0;
const archiveWallItems = useSplitArchiveLayout ? archiveStaticItems : project.media;
---

<section class="project-media">
  <Container>
    <div class="poster-section__intro">
      <p class="poster-section__eyebrow">{projectLabel(projectDetailContent.materialsEyebrow, locale)}</p>
      <h2 class="poster-section__title">{projectLabel(projectDetailContent.materialsTitle, locale)}</h2>
    </div>
    {useImageWall ? (
      <div class="project-media__sections">
        {archiveWallItems.length > 0 ? (
          <div class="project-media__section">
            {useSplitArchiveLayout ? (
              <h3 class="project-media__section-title">
                {projectLabel(projectDetailContent.staticWorksTitle, locale)}
              </h3>
            ) : null}
            <ArchiveMediaWall
              client:visible
              closePreviewLabel={projectDetailContent.closePreviewLabel}
              items={archiveWallItems}
              locale={locale}
              photoCreditLabel={projectDetailContent.photoCreditLabel}
              previewDialogLabel={projectDetailContent.previewDialogLabel}
              previewLabel={projectDetailContent.previewLabel}
            />
          </div>
        ) : null}
        {useSplitArchiveLayout ? (
          <div class="project-media__section">
            <h3 class="project-media__section-title">
              {projectLabel(projectDetailContent.videoWorksTitle, locale)}
            </h3>
            <div class="project-media__video-grid">
              {archiveVideoItems.map((item) => (
                <article class="project-media__video-card signal-panel">
                  {item.src ? (
                    <div class="project-media__video-thumb">
                      <PortfolioImage
                        alt={projectLabel(item.title, locale)}
                        fill
                        loading="lazy"
                        sizes="(max-width: 760px) 100vw, (max-width: 1120px) 50vw, 42vw"
                        src={item.src}
                        width={item.width ?? (item.src ? getImageWidth(item.src) : undefined)}
                      />
                    </div>
                  ) : null}
                  <div class="project-media__video-copy">
                    <h3>{projectLabel(item.title, locale)}</h3>
                    <p>{projectLabel(item.description, locale)}</p>
                    {item.href ? (
                      <a class="button button--signal" href={item.href} rel="noreferrer" target="_blank">
                        {projectLabel(projectDetailContent.watchOnYouTubeLabel, locale)}
                        <span class="visually-hidden">(opens in new tab)</span>
                      </a>
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ) : null}
      </div>
    ) : (
      <div class="project-media__grid">
        {project.media.map((item) => (
          <article class={`project-media__card signal-panel${item.layout ? ` project-media__card--${item.layout}` : ""}`}>
            <div class="project-media__badge">{item.badge ? projectLabel(item.badge, locale) : item.type}</div>
            {item.type === "image" && item.src ? (
              <div class={`project-media__image${item.layout ? ` project-media__image--${item.layout}` : ""}`}>
                <PortfolioImage
                  alt={projectLabel(item.title, locale)}
                  fill
                  loading="lazy"
                  sizes="(max-width: 1120px) 100vw, 28vw"
                  src={item.src}
                  width={item.width ?? (item.src ? getImageWidth(item.src) : undefined)}
                />
              </div>
            ) : null}
            <h3>{projectLabel(item.title, locale)}</h3>
            <p>{projectLabel(item.description, locale)}</p>
            {item.credit ? (
              <p class="project-media__credit">
                {projectLabel(projectDetailContent.photoCreditLabel, locale)}:{" "}
                <a href={item.credit.href} rel="noreferrer" target="_blank">
                  {projectLabel(item.credit.label, locale)}
                  <span class="visually-hidden">(opens in new tab)</span>
                </a>
              </p>
            ) : null}
            {item.href ? (
              <a class="project-card__cta" href={item.href} rel="noreferrer" target="_blank">
                {projectLabel(projectDetailContent.openResourceLabel, locale)}
                <span class="visually-hidden">(opens in new tab)</span>
              </a>
            ) : null}
          </article>
        ))}
      </div>
    )}
  </Container>
</section>
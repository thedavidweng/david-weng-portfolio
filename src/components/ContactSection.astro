---
import Container from "@/src/components/Container.astro";
import Icon from "@/src/components/Icon.astro";
import { contactContent } from "@/content/site";
import { getLocalizedText } from "@/lib/i18n";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (value: { en: string; zh: string }) => getLocalizedText(value, locale);
const mailto = `mailto:${contactContent.email}`;
---

<section class="section-shell" id="contact">
  <Container>
    <div class="contact-hero">
      <h2 class="contact-hero__title">
        {t(contactContent.title)}{" "}
        <span>{t(contactContent.unseenLabel)}</span>
      </h2>
      <a class="contact-hero__email" href={mailto}>{contactContent.email}</a>
      <div class="contact-hero__actions">
        <a class="contact-hero__button contact-hero__button--primary" href={mailto}>{t(contactContent.emailLabel)}</a>
        <button
          class="contact-hero__button js-only"
          type="button"
          data-copy={contactContent.email}
          data-copied-label={t(contactContent.copiedLabel)}
        >
          <Icon name="copy" /><span aria-live="polite">{t(contactContent.copyLabel)}</span>
        </button>
      </div>
      <nav class="contact-hero__socials" aria-label={t(contactContent.socialsLabel)}>
        {contactContent.socials.map((item) => (
          <a class="contact-hero__social" href={item.href}><Icon name={item.icon} />{item.label}</a>
        ))}
      </nav>
    </div>
  </Container>
</section>

---
import type { Locale, ServiceItem } from "@/types/content";
import { getLocalizedText } from "@/lib/i18n";

interface Props {
  index: number;
  locale: Locale;
  service: ServiceItem;
}

const { index, locale, service } = Astro.props;
---

<article class="frame-card service-card">
  <span class="frame-card__meta">({String(index + 1).padStart(2, "0")})</span>
  <h3 class="service-card__title">{getLocalizedText(service.title, locale)}</h3>
  <p class="frame-card__desc">{getLocalizedText(service.description, locale)}</p>
</article>

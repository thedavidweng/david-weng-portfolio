---
import type { Locale, ServiceItem } from "@/types/content";
import { getLocalizedText } from "@/lib/i18n";

interface Props {
  index: number;
  locale: Locale;
  service: ServiceItem;
}

const { index, locale, service } = Astro.props;
---

<article class={`service-card signal-panel${locale === "zh" ? " service-card--zh" : ""}`}>
  <span class="service-card__index">[{String(index + 1).padStart(2, "0")}]</span>
  <h3 class="service-card__title">{getLocalizedText(service.title, locale)}</h3>
  <p>{getLocalizedText(service.description, locale)}</p>
</article>
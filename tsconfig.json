{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["./*"] },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src/**/*", "content/**/*", "lib/**/*", "tests/**/*", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist"]
}
